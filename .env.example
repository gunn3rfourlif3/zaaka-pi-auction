# ============================================================================
# Local development environment — TEMPLATE (placeholders only)
# Copy to .env and fill in. Do NOT commit your real .env.
# ============================================================================

# Database (local MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/auction_dev"

# Pi Network API (use TESTNET/sandbox keys for development)
PI_API_KEY="your-sandbox-pi-api-key"
PI_CLIENT_SECRET="your-sandbox-pi-client-secret"
PI_WALLET_SEED="your-testnet-wallet-seed"
PI_NETWORK_ENVIRONMENT="sandbox"
PI_APP_ID="your-app-id"

# Environment
NODE_ENV=development

# Session / auth secrets (generate: openssl rand -hex 32)
SESSION_SECRET="dev-only-change-me-0000000000000000000000000000000000000000000000"
JWT_SECRET="dev-only-change-me-0000000000000000000000000000000000000000000000"

# Admin UIDs/usernames (comma-separated) for settlement/admin routes
ADMIN_UIDS=""

# Cron settlement shared secret
CRON_SECRET="dev-cron-secret"
