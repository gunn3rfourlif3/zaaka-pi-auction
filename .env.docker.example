# ============================================================================
# Docker Compose environment — copy to .env.docker and fill in.
#   cp .env.docker.example .env.docker   &&   edit
# .env.docker is git-ignored. NEVER commit real secrets.
# ============================================================================

# --- MySQL (used by the db service AND to assemble DATABASE_URL) -------------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=zaaka_auction
MYSQL_USER=auction_app
MYSQL_PASSWORD=change_me_app_password

# --- Application ------------------------------------------------------------
NODE_ENV=production
# Use sandbox/testnet for staging, mainnet for production.
PI_NETWORK_ENVIRONMENT=sandbox
NEXTAUTH_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example

# --- Pi Network (rotated keys — never the old committed ones) ---------------
PI_API_KEY=CHANGE_ME
PI_CLIENT_SECRET=CHANGE_ME
PI_WALLET_SEED=CHANGE_ME
PI_APP_ID=your-app-id

# --- Session / auth (openssl rand -hex 32) ----------------------------------
SESSION_SECRET=CHANGE_ME_RANDOM_HEX
JWT_SECRET=CHANGE_ME_RANDOM_HEX
ADMIN_UIDS=

# --- Cron/settlement secret (used if you call the HTTP cron endpoint) -------
CRON_SECRET=CHANGE_ME_RANDOM_HEX

# --- Uploads (matches the compose volume mount) -----------------------------
UPLOAD_DIR=/app/public/uploads

# NOTE: DATABASE_URL is assembled automatically in docker-compose.yml from the
# MYSQL_* values above (host = the `db` service). No need to set it here.
