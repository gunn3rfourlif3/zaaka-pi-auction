generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  // "native" covers local dev; the debian target matches the Docker image
  // (node:20-bookworm-slim) so the client works both places.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // Keep this line empty for Prisma 7 compliance
}

// ... your models below

model auctions {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text // Add this
  currentBid  Decimal  @default(0.00) @db.Decimal(10, 2) // Add this
  seller_id   String   @db.VarChar(255)
  category    String?  @default("General") // <--- Add this line
  status      String?  @default("OPEN") @db.VarChar(50)
  delivered   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  expires_at  DateTime
  starts_at   DateTime @default(now())

  escrow_ledger escrow_ledger[]
  images        auction_images[]
  bids          bids[]
  messages      messages[]
  auto_bids     auto_bids[]
  reviews       reviews[]
}

model auction_images {
  id        Int    @id @default(autoincrement())
  url       String @db.Text
  auctionId Int

  // Linking back to the auction
  auction auctions @relation(fields: [auctionId], references: [id], onDelete: Cascade)
}

model bids {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(10, 2)
  bidder_id     String
  // Unique so a replayed Pi callback cannot record the same payment twice.
  // (MySQL allows multiple NULLs, so mock/no-payment rows are unaffected.)
  pi_payment_id String?  @unique @db.VarChar(255)
  auctionId     Int
  auction       auctions @relation(fields: [auctionId], references: [id])
  created_at    DateTime @default(now())

  @@index([auctionId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model escrow_ledger {
  id             Int      @id @default(autoincrement())
  amount         Decimal  @db.Decimal(10, 2)
  payment_status String   @db.VarChar(50)
  payout_status  String?  @default("PENDING") @db.VarChar(50)
  pi_payment_id  String?  @db.VarChar(255)
  auction_id     Int
  winner_id      String   @db.VarChar(255)
  seller_id      String   @db.VarChar(255)
  auctions       auctions @relation(fields: [auction_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "escrow_ledger_ibfk_1")

  @@index([auction_id], map: "auction_id")
}

model messages {
  id          Int      @id @default(autoincrement())
  sender_id   String   @db.VarChar(255)
  receiver_id String   @db.VarChar(255)
  content     String   @db.Text
  auction_id  Int
  created_at  DateTime @default(now())
  read        Boolean  @default(false)

  auction     auctions @relation(fields: [auction_id], references: [id], onDelete: Cascade)

  @@index([auction_id])
  @@index([sender_id])
  @@index([receiver_id])
}

model auto_bids {
  id            Int      @id @default(autoincrement())
  auction_id    Int
  bidder_id     String   @db.VarChar(255)
  max_amount    Decimal  @db.Decimal(10, 2)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Link to auction
  auction       auctions @relation(fields: [auction_id], references: [id], onDelete: Cascade)

  @@index([auction_id])
}

/// Buyer/seller reviews left after a completed auction (Phase 5: ratings).
model reviews {
  id         Int      @id @default(autoincrement())
  auction_id Int
  rater_id   String   @db.VarChar(255) // who wrote the review
  ratee_id   String   @db.VarChar(255) // who is being reviewed
  role       String   @db.VarChar(20)  // the ratee's role: 'SELLER' or 'BUYER'
  stars      Int // 1..5
  comment    String?  @db.Text
  created_at DateTime @default(now())

  auction auctions @relation(fields: [auction_id], references: [id], onDelete: Cascade)

  // One review per counterpart per auction.
  @@unique([auction_id, rater_id, ratee_id])
  @@index([ratee_id])
  @@index([auction_id])
}

/// In-app notifications (Phase 5). user_id matches the username used on bids/escrow.
model notifications {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.VarChar(255)
  type       String   @db.VarChar(50) // OUTBID, WON, SOLD, PAYOUT, DELIVERY
  message    String   @db.Text
  auction_id Int?
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([read])
}

/// Immutable audit trail of money-affecting events (Phase 5).
model audit_log {
  id            Int      @id @default(autoincrement())
  event_type    String   @db.VarChar(50) // BID, SETTLE, PAYOUT, CONFIRM, REFUND
  actor         String?  @db.VarChar(255)
  auction_id    Int?
  amount        Decimal? @db.Decimal(10, 2)
  pi_payment_id String?  @db.VarChar(255)
  meta          String?  @db.Text // JSON blob
  created_at    DateTime @default(now())

  @@index([auction_id])
  @@index([event_type])
}
