# ============================================================================
# Production Environment Configuration — TEMPLATE (placeholders only)
# ----------------------------------------------------------------------------
# Copy to a secrets file OUTSIDE the repo (e.g. /etc/pi-auctions.env, chmod 600)
# and fill in real values there. NEVER commit real credentials.
#
# ⚠️  Any real key ever committed to git must be treated as compromised and
#     rotated at the source (Pi Developer Portal / DB / wallet).
# ============================================================================

# --- Database (MySQL) -------------------------------------------------------
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://APP_DB_USER:CHANGE_ME@localhost:3306/APP_DB_NAME"

# --- Redis (optional; recommended for real-time + rate limiting) ------------
# REDIS_URL="redis://localhost:6379"

# --- Pi Network API ---------------------------------------------------------
PI_API_KEY="CHANGE_ME_PI_API_KEY"
PI_CLIENT_SECRET="CHANGE_ME_PI_CLIENT_SECRET"
PI_WALLET_SEED="CHANGE_ME_WALLET_SEED"        # controls payouts — keep in a secrets manager
PI_NETWORK_ENVIRONMENT="mainnet"              # "sandbox" for testnet, "mainnet" for production
PI_APP_ID="your-app-id"

# --- Application Environment ------------------------------------------------
NODE_ENV=production

# --- Session / Auth ---------------------------------------------------------
# 32+ byte random hex. Generate: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_RANDOM_HEX"
JWT_SECRET="CHANGE_ME_RANDOM_HEX"
NEXTAUTH_URL="https://your-domain.example"

# Comma-separated Pi UIDs (or usernames) allowed to hit admin/settlement routes
ADMIN_UIDS=""

# Shared secret required by the cron settlement endpoint (Bearer token)
CRON_SECRET="CHANGE_ME_RANDOM_HEX"

# --- File Upload ------------------------------------------------------------
MAX_FILE_SIZE=5242880                          # 5MB
UPLOAD_DIR="/var/lib/pi-auctions/uploads"      # persistent path outside the build dir

# --- Email (optional, for notifications) ------------------------------------
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Pi Auction <notifications@your-domain.example>"

# --- Rate Limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000                    # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging / Performance --------------------------------------------------
LOG_LEVEL="info"
CACHE_TTL=300
DB_POOL_SIZE=10
CONNECTION_TIMEOUT=30000
